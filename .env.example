# Neon Postgres connection string (used by Prisma).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Vercel Blob storage — used to persist page screenshots captured during extraction.
BLOB_READ_WRITE_TOKEN=""

# Managed headless-browser service (e.g. Browserless) used if launching
# Chromium directly from the API route isn't viable in this environment.
# Leave empty if running Playwright's own bundled Chromium instead.
BROWSERLESS_API_KEY=""

# NOTE: AI provider API keys (OpenAI, Anthropic, etc.) are BYOK — supplied by
# the user per-request from the client. They are never stored in env vars,
# never persisted server-side, and never logged. Do not add them here.
